<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backups and device-to-device transfer: keep only the child's progress. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="rq.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="rq.xml" />
    </device-transfer>
</data-extraction-rules>
